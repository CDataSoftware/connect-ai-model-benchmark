# Template. Copy to .env (git-ignored) and fill in your own values.

# Connect AI MCP auth -- Basic (email:PAT).
CDATA_EMAIL=your-email@example.com
CDATA_ACCESS_TOKEN=your-connect-ai-pat

# MCP endpoints -- R1 (two conditions)
#   Baseline: the clean raw-federation Toolkit (6 synthetic tables, universal tools only,
#     no derived view -- see docs/TEST_PLAN.md "Account Data Access").
#   Optimized: your curated Toolkit endpoint over the account_health_score Derived View
#     ("Account Health Insights") -- replace <your-toolkit-id> with your Toolkit's ID.
MCP_BASELINE_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<your-baseline-toolkit-id>
MCP_OPTIMIZED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<your-toolkit-id>

# MCP endpoints -- R2 + A1 (read composition + write-back; see docs/TEST_PLAN.md)
#   Read (R2): curated tools over account_health_score + account_usage_trend.
#   Actions (A1): write-back to REVIEW_QUEUE, guarded (server-side eligibility check + dedupe)
#     vs raw (unvalidated) -- both toolkits expose a tool named queue_account_review; they are
#     distinguished only by which URL is used, never by tool name (see docs/TEST_PLAN.md).
#   Baseline-write: raw 6 tables + REVIEW_QUEUE via universal tools only (execute_insert),
#     no curated tools -- the write-side analog of MCP_BASELINE_URL.
MCP_R2_OPTIMIZED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-and-usage-insights-toolkit-id>
MCP_A1_GUARDED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-review-automation-toolkit-id>
MCP_A1_UNGUARDED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-review-automation-direct-toolkit-id>
MCP_A1_BASELINE_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-data-access-write-toolkit-id>

# Harness-internal verifier (core/verifier.py) -- resets REVIEW_QUEUE before every A1 run and reads
# it back afterwards for scoring. Never given to a model under test: grading a write task through
# the same access being measured would be circular.
# Uses CData's general REST query API rather than MCP, because MCP's execute_insert rejects anything
# but INSERT and therefore cannot reset the table; the REST endpoint does accept DELETE.
#
# WH_CONN: the name of your data warehouse connection in Connect AI.
# Set this to match whatever you named the connection in the Connect AI UI. Used by the verifier
# to query the source tables for off-target write detection.
WH_CONN=your-warehouse-connection-name
# REVIEW_QUEUE_TABLE: full path to the REVIEW_QUEUE table.
# Override if your connection name or schema differs from the default.
REVIEW_QUEUE_TABLE=your-warehouse-connection-name.WH_DATA.REVIEW_QUEUE
# CDATA_QUERY_API=https://cloud.cdata.com/api/query

# Provider API keys. Put them here (this file is loaded into the environment at startup)
# or export them in your shell -- either works. One key per line, no inline comments.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
XAI_API_KEY=xai-...

# Open / self-hosted model keys. Add one per provider; the name must match api_key_env in
# models.yaml. Local servers (Ollama) don't need an entry — omit api_key_env in models.yaml.
# TOGETHER_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...
