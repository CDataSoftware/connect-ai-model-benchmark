# Template. Copy to .env (git-ignored) and fill in your own values.

# Connect AI MCP auth -- Basic (email:PAT).
CDATA_EMAIL=your-email@example.com
CDATA_ACCESS_TOKEN=your-connect-ai-pat

# MCP endpoints. Raw-access conditions use Connect AI's standard endpoint, scoped by an ?ops=
# allowlist of operations, and authenticate with CDATA_EMAIL + CDATA_ACCESS_TOKEN. Each condition
# with shared context differs from its raw-access pair only by search_context.
#
#   R1 / R2 raw access: read-only tools across all connections.
MCP_BASELINE_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData
MCP_BASELINE_CONTEXT_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData,search_context
#   A1 raw access: the same read tools plus execute_insert (INSERT only) for writing REVIEW_QUEUE.
MCP_A1_BASELINE_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData,execute_insert
MCP_A1_BASELINE_CONTEXT_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData,execute_insert,search_context
#
# Curated conditions (switched off in config/models.yaml for the current edition): one endpoint
# per curated tool set, as either a Toolkit URL (PAT auth) or a Tool Server URL copied from
# Connect AI (OAuth -- run `python3 -m core.mcp_oauth login` once before the matrix).
#   Toolkit:     https://mcp.cloud.cdata.com/mcp/toolkits/<toolkit-id>
#   Tool Server: <tool-server-url>, ending /mcp/workspaces/<workspace-id>/toolservers/<tool-server-id>
#   R1 / R2: curated read tools. A1 guarded: write tool with server-side eligibility check and
#   dedupe. A1 unguarded: the same tool without validation. Guarded and unguarded both expose a tool
#   named queue_account_review and are distinguished only by URL (see docs/TEST_PLAN.md).
MCP_OPTIMIZED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<your-toolkit-id>
MCP_R2_OPTIMIZED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-and-usage-insights-toolkit-id>
MCP_A1_GUARDED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-review-automation-toolkit-id>
MCP_A1_UNGUARDED_URL=https://mcp.cloud.cdata.com/mcp/toolkits/<account-review-automation-direct-toolkit-id>
# MCP_OAUTH_PORT=53682   # local port for the OAuth login callback, if 53682 is taken

# Harness-internal verifier (core/verifier.py) -- resets REVIEW_QUEUE before every A1 run and reads
# it back afterwards for scoring. Never given to a model under test: grading a write task through
# the same access being measured would be circular.
# Uses CData's general REST query API rather than MCP, because MCP's execute_insert rejects anything
# but INSERT and therefore cannot reset the table; the REST endpoint does accept DELETE.
# The Connect AI user needs Select, Insert and Delete on the warehouse connection (Insert for the
# model's writes, Delete for the reset) and Select only on the CRM and ITSM connections, whose
# tables the verifier does not watch for off-target writes.
#
# WH_CONN: the name of your warehouse connection in Connect AI (e.g. Snowflake_WH). Used by the
# verifier to count DIM_ACCOUNT and TELEMETRY_EVENTS rows for off-target write detection.
WH_CONN=your-warehouse-connection-name
# REVIEW_QUEUE_TABLE: full path to the REVIEW_QUEUE table.
REVIEW_QUEUE_TABLE=your-warehouse-connection-name.WH_DATA.REVIEW_QUEUE
# CDATA_QUERY_API=https://cloud.cdata.com/api/query

# Provider API keys. Put them here (this file is loaded into the environment at startup)
# or export them in your shell -- either works. One key per line, no inline comments.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
XAI_API_KEY=xai-...

# Open-weight model keys; the name must match api_key_env in models.yaml. The current roster
# serves open-weight models through Together and Mistral. Local servers (Ollama) don't need an
# entry -- omit api_key_env in models.yaml.
TOGETHER_API_KEY=...
MISTRAL_API_KEY=...
# GROQ_API_KEY=...
